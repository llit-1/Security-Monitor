<Window x:Class="Security_Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security Monitor"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#FF1E1E1E"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Storyboard x:Key="ShowStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.4"/>
        </Storyboard>

        <Storyboard x:Key="HideStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0" Duration="0:0:0.4"/>
        </Storyboard>
    </Window.Resources>
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- Данные -->
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <!-- Фото -->
                <ColumnDefinition Width="*"/>
                <!-- Пустое пространство -->
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="8.65*"></RowDefinition>
                <RowDefinition Height="1* "></RowDefinition>
                <RowDefinition Height="2* "></RowDefinition>
                <RowDefinition Height="1* "></RowDefinition>
            </Grid.RowDefinitions>
            
            
            <!-- Данные человека -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,20,0">
                <!-- Фамилия -->
                <StackPanel Margin="0,0,0,5">
                    <TextBlock Text="Фамилия" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <Border Background="White" CornerRadius="8" Padding="5" Width="480" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Surname}" FontSize="24" FontWeight="SemiBold" Foreground="Black"/>
                    </Border>
                </StackPanel>

                <!-- Имя -->
                <StackPanel Margin="0,0,0,5">
                    <TextBlock Text="Имя" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <Border Background="White" CornerRadius="8" Padding="5" Width="480" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" Foreground="Black"/>
                    </Border>
                </StackPanel>

                <!-- Отчество -->
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Отчество" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <Border Background="White" CornerRadius="8" Padding="5" Width="480" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Patronymic}" FontSize="24" FontWeight="SemiBold" Foreground="Black"/>
                    </Border>
                </StackPanel>

                <!-- Возраст -->
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Возраст" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <Border Background="White" CornerRadius="8" Padding="5" Width="480" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Age}" FontSize="24" FontWeight="SemiBold" Foreground="Black"/>
                    </Border>
                </StackPanel>

                <!-- Отдел -->
                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="Отдел" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <Border Background="White" CornerRadius="8" Padding="5" Width="480" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Department}" FontSize="24" FontWeight="SemiBold" Foreground="Black"/>
                    </Border>
                </StackPanel>

                <!-- Цех -->
                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="Цех" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <Border Background="White" CornerRadius="8" Padding="5" Width="480" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Workshop}" FontSize="24" FontWeight="SemiBold" Foreground="Black"/>
                    </Border>
                </StackPanel>

                <!-- Должность -->
                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="Должность" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <Border Background="White" CornerRadius="8" Padding="5" Width="480" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding JobTitle}" FontSize="24" FontWeight="SemiBold" Foreground="Black"/>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="Ридер" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <Border Background="White" CornerRadius="8" Padding="5" Width="480" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Reader}" FontSize="24" FontWeight="SemiBold" Foreground="Black"/>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="Время" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <Border Background="White" CornerRadius="8" Padding="5" Width="480" HorizontalAlignment="Left"> 
                        <TextBlock Text="{Binding Time}" FontSize="24" FontWeight="SemiBold" Foreground="Black"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Border x:Name="AccessBorder" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="3" Background="#8FAE29" CornerRadius="8" Padding="10" Opacity="0">
                <TextBlock Text="Проход разрешен" FontSize="80" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>


            <!-- Фото -->
            <Border Grid.Column="1"
            Width="694" Height="694"
            Margin="0,37,0,0"
            CornerRadius="8"
            Background = "DimGray"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
                <Grid>
                    <Image Source="{Binding Photo}" Stretch="UniformToFill">
                        <Image.Clip>
                            <RectangleGeometry RadiusX="8" RadiusY="8"
                                   Rect="0,0,694,694"/>
                            <!-- уменьшаем на толщину рамки -->
                        </Image.Clip>
                    </Image>
                </Grid>
            </Border>
            <Border Grid.Column="2"
            Width="694" Height="694"
            Margin="20,37,0,0"
            CornerRadius="8"
            Background = "DimGray"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
                <Grid>
                    <Image Source="{Binding PhotoNX}" Stretch="UniformToFill">
                        <Image.Clip>
                            <RectangleGeometry RadiusX="8" RadiusY="8"
                           Rect="0,0,694,694"/>
                            <!-- уменьшаем на толщину рамки -->
                        </Image.Clip>
                    </Image>
                </Grid>
            </Border>
            </Grid>
    </Viewbox>
</Window>