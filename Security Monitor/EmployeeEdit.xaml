<Window x:Class="Security_Monitor.EmployeeEdit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Security_Monitor.ViewModels"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#FF1E1E1E"
        KeyDown="Window_KeyDown">

    <Window.DataContext>
        <vm:EmployeeEditViewModel/>
    </Window.DataContext>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= PASSPORT ================= -->
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0 0 20 0" Grid.ColumnSpan="2">

            <TextBlock Text="Паспорт" FontSize="28" FontWeight="Bold" Foreground="White"/>

            <Grid>

                <!-- ОСНОВНОЕ ПОЛЕ -->
                <Border x:Name="searchContainer"
                        Background="White"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="5">

                    <TextBox x:Name="txtSearch"
                             Text="{Binding SelectedPassport, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             VerticalAlignment="Center"
                             Padding="0"
                             FontSize="26"/>
                </Border>

                <!-- КНОПКА - ИЗМЕНЕНО С ToggleButton НА Button -->
                <Button x:Name="btnDropDown"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        Width="30"
                        HorizontalAlignment="Right"
                        Margin="0,0,5,0"
                        Cursor="Hand"
                        Click="btnDropDown_Click">

                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                      Fill="Black"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- POPUP -->
                <Popup x:Name="popupResults"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=searchContainer}"
                       HorizontalOffset="0"
                       VerticalOffset="6"
                       AllowsTransparency="True"
                       Focusable="False"
                       StaysOpen="True">

                    <Border Background="White"
                            BorderBrush="Gray"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4"
                            ClipToBounds="True"
                            Width="{Binding ActualWidth, ElementName=searchContainer}">

                        <ScrollViewer MaxHeight="300">
                            <ListBox x:Name="lstResults"
                                     SelectionChanged="lstResults_SelectionChanged"
                                     FontSize="24"/>
                        </ScrollViewer>

                    </Border>
                </Popup>

            </Grid>
        </StackPanel>

        <!-- ЛЕВАЯ ЧАСТЬ (остаётся без изменений) -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0 0 20 0">

            <TextBlock Text="Фамилия" FontSize="28" Foreground="White"/>
            <Border Background="White" CornerRadius="8" Padding="5" Margin="0 0 0 10">
                <TextBlock Text="{Binding Surname}" FontSize="24"/>
            </Border>

            <TextBlock Text="Имя" FontSize="28" Foreground="White"/>
            <Border Background="White" CornerRadius="8" Padding="5" Margin="0 0 0 10">
                <TextBlock Text="{Binding Name}" FontSize="24"/>
            </Border>

            <TextBlock Text="Отчество" FontSize="28" Foreground="White"/>
            <Border Background="White" CornerRadius="8" Padding="5" Margin="0 0 0 10">
                <TextBlock Text="{Binding Patronymic}" FontSize="24"/>
            </Border>

            <TextBlock Text="Дата рождения" FontSize="28" Foreground="White"/>
            <Border Background="White" CornerRadius="8" Padding="5" Margin="0 0 0 10">
                <TextBlock Text="{Binding Birthdate}" FontSize="24"/>
            </Border>

            <TextBlock Text="Отдел" FontSize="28" Foreground="White"/>
            <Border Background="White" CornerRadius="8" Padding="5" Margin="0 0 0 10">
                <TextBlock Text="{Binding Department}" FontSize="24"/>
            </Border>

            <TextBlock Text="Цех" FontSize="28" Foreground="White"/>
            <Border Background="White" CornerRadius="8" Padding="5" Margin="0 0 0 10">
                <TextBlock Text="{Binding Workshop}" FontSize="24"/>
            </Border>

            <TextBlock Text="Должность" FontSize="28" Foreground="White"/>
            <Border Background="White" CornerRadius="8" Padding="5" Margin="0 0 0 10">
                <TextBlock Text="{Binding JobTitle}" FontSize="24"/>
            </Border>

            <TextBlock Text="Номер карты" FontSize="28" Foreground="White"/>
            <Border Background="White" CornerRadius="8" Padding="5">
                <TextBlock Text="{Binding PassCardNumber}" FontSize="24"/>
            </Border>

        </StackPanel>

        <!-- ФОТО -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Background="DimGray"
                CornerRadius="8"
                Margin="0 36 20 0"
                ClipToBounds="True">

            <Grid>
                <Image x:Name="EmployeePhoto"
                       Source="{Binding Photo}"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Loaded="EmployeePhoto_Loaded"
                       SizeChanged="EmployeePhoto_SizeChanged">
                    <Image.Clip>
                        <RectangleGeometry x:Name="ImageClip"
                                           RadiusX="8"
                                           RadiusY="8"/>
                    </Image.Clip>

                </Image>
            </Grid>
        </Border>

    </Grid>
</Window>